# ═══════════════════════════════════════════════════════════════════════════════
#  Trading Bot — Environment Configuration
#  Copy this file to .env and fill in your credentials.
#  NEVER commit the real .env file to version control.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Alpaca ────────────────────────────────────────────────────────────────────
# Sign up for free at https://alpaca.markets (paper trading requires no deposit)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# Paper trading endpoint (default — safe for testing)
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Live trading endpoint — uncomment when ready for real money:
# ALPACA_BASE_URL=https://api.alpaca.markets

# ── News API ──────────────────────────────────────────────────────────────────
# Free tier at https://newsapi.org (100 req/day is sufficient for testing)
# Leave blank to use RSS fallback only.
NEWS_API_KEY=your_newsapi_key_here

# ── Trading mode ──────────────────────────────────────────────────────────────
TRADING_MODE=paper          # paper | live

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=trading_bot.db      # SQLite file path for trade/signal history

# ── Risk parameters (all have safe defaults — tune carefully) ─────────────────
MAX_POSITION_SIZE=0.05      # Max fraction of portfolio per position (5%)
MAX_PORTFOLIO_HEAT=0.20     # Max total open risk across all positions (20%)
STOP_LOSS_PCT=0.05          # Default stop-loss distance from entry (5%)
TAKE_PROFIT_PCT=0.15        # Default take-profit distance from entry (15%)
MAX_DAILY_DRAWDOWN=0.03     # Circuit-breaker: halt if daily loss exceeds 3%
MAX_SHORT_POSITIONS=5       # Maximum concurrent short positions
RISK_PER_TRADE=0.01         # Fraction of portfolio risked per trade (1%)

# ── Signal weights (must sum to ~1.0) ─────────────────────────────────────────
TECHNICAL_WEIGHT=0.35
SENTIMENT_WEIGHT=0.30
MOMENTUM_WEIGHT=0.20
FUNDAMENTAL_WEIGHT=0.15

# ── Signal thresholds ────────────────────────────────────────────────────────
BUY_THRESHOLD=0.35
SELL_THRESHOLD=-0.20
SHORT_THRESHOLD=-0.35
COVER_THRESHOLD=0.20
VIX_MAX=40.0                # Stop opening new positions when VIX exceeds this

# ── Scheduling intervals ──────────────────────────────────────────────────────
SIGNAL_SCAN_INTERVAL_MINUTES=1
PORTFOLIO_REFRESH_INTERVAL_MINUTES=5
NEWS_REFRESH_INTERVAL_MINUTES=60

# ── Data settings ─────────────────────────────────────────────────────────────
BARS_LIMIT=200              # Historical bars to fetch for technical analysis
NEWS_DAYS_BACK=2            # Days of news history to pull per symbol
MAX_NEWS_ARTICLES=10        # Articles to process per symbol per cycle

# ── Sentiment model ───────────────────────────────────────────────────────────
# HuggingFace model ID — ProsusAI/finbert is the standard financial BERT
FINBERT_MODEL=ProsusAI/finbert
SENTIMENT_BATCH_SIZE=8
